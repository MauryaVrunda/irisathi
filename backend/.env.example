# IRISaathi Backend Configuration
APP_NAME=IRISaathi Clinical Screening API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# SQLite database path (relative paths resolve against backend/)
DATABASE_URL=sqlite:///./app/storage/irisaathi.db

# File storage directories (relative paths resolve against backend/)
UPLOAD_DIR=./app/storage/uploads
REPORT_DIR=./app/storage/reports

# Comma-separated CORS origins for React / Vite dev servers
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Upload constraints & optional model checkpoint
MAX_UPLOAD_SIZE_MB=15
MODEL_WEIGHTS_PATH=
SEED_DEMO_ON_STARTUP=true
